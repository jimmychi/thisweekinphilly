# Copy this to .env and fill in your API keys

# Ticketmaster Discovery API
# Get your key at: https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=your_ticketmaster_api_key_here

# Eventbrite API
# Get your key at: https://www.eventbrite.com/platform/api
EVENTBRITE_API_KEY=your_eventbrite_private_token_here

# The URL of your deployed frontend (for CORS)
CLIENT_URL=https://thisweekinphilly.com

# Port (Render sets this automatically)
PORT=3001
